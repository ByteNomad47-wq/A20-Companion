 </FrameLayout>
 <TextView android:id="@+id/widget_case_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/widget_unknown" android:textColor="#EEEAF4" android:textSize="18sp" android:textStyle="bold" android:importantForAccessibility="no" android:visibility="gone"/>
